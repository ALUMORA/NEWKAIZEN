# Build de e2e (vite build --mode e2e), que sirve playwright.config.js con vite preview.
# El API apunta a un host que no existe: toda prueba mockea el API (e2e/support/mockApi.js).
VITE_API_URL=http://api.test
# Gana sobre un .env.local de desarrollo: en e2e la sesión se siembra (e2e/support/auth.js).
VITE_SKIP_LOGIN=false
