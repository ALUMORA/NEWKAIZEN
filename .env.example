# Variables del frontend (Vite). Copia lo que necesites a .env.development.local para `npm run dev`.
# Ojo: Vite también lee .env.local al hacer `vite build`; lo que pongas ahí termina en el build de
# producción. Para desarrollo usa .env.development.local.

# URL del backend, sin diagonal final. Sin ella: http://localhost:8002 en `npm run dev` y
# https://app-4-everyone.onrender.com en un build. En Vercel se define en el proyecto.
# La CSP de vercel.json solo deja conectar a 'self' y a https://*.onrender.com: si el API vive en
# otro dominio, hay que agregarlo a connect-src.
VITE_API_URL=http://localhost:8002

# "true" activa los adaptadores del API viejo (v1 → v2) para historia, cotizaciones, tipo de
# cambio y tasa libre de riesgo cuando /health dice que el servidor es el anterior.
VITE_ALLOW_LEGACY=false

# SOLO DESARROLLO. "true" crea una sesión de prueba (usuario "dev", 12 h, sin token) para no pasar
# por el login en `npm run dev`. No tiene efecto en ningún build: el código solo existe cuando
# import.meta.env.DEV es true.
VITE_SKIP_LOGIN=false
