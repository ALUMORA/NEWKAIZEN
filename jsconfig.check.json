{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/lib/**/*.js", "src/test/typecheck-anchor.js"],
  "exclude": ["node_modules", "dist", "src/**/*.test.js"]
}
